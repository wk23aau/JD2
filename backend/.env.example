# Backend Environment Variables Example
# -------------------------------------
# Copy this file to .env in this directory for local development,
# or set these variables in your deployment environment.
#
# For different environments (e.g., test, production), you can create specific files
# like .env.test or .env.production, which will be loaded by src/config/index.ts.

# Node Environment
# Options: development, production, test
NODE_ENV=development

# Server Port
PORT=3001

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=your_db_username # e.g., root
DB_PASSWORD=your_db_password
DB_NAME=ai_cv_maker_db_new # Or your preferred database name

# JSON Web Token (JWT) Configuration
# IMPORTANT: Use a long, random, and secret string for production!
JWT_SECRET="a_very_secure_and_long_random_string_for_jwt_secret"

# Google OAuth 2.0 Configuration
# These are obtained from Google Cloud Platform (https://console.cloud.google.com/)
# See README.md for instructions on setting up Google OAuth.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_FROM_GCP"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_FROM_GCP"
# Full callback URL for your backend, must match "Authorized redirect URIs" in GCP.
# Example (local dev): http://localhost:3001/api/auth/google/callback
# Example (prod): https://yourdomain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="/api/auth/google/callback"

# Frontend URL for OAuth Failure Redirects
# URL to your frontend's login page. Used by the backend for OAuth error redirects.
# Example (local dev): http://localhost:3000/login
# Example (prod): https://yourfrontenddomain.com/login
FRONTEND_LOGIN_URL="/login"

# CORS Configuration
# For development, '*' might be okay. For production, list your specific frontend domain(s).
# Example: CORS_ORIGIN=https://yourfrontenddomain.com
CORS_ORIGIN=*

# Google Gemini API Key
# Obtain this key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Used for AI-powered content suggestions.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"
