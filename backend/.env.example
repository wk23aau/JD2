# This file provides an example of environment variables needed for the backend.
# Copy this file to .env in the same directory and replace the placeholder values
# with your actual configuration values.
# DO NOT commit your .env file to version control if it contains sensitive data.

# Application Port
# PORT=3001

# Database Configuration (MySQL)
DB_HOST="localhost"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_NAME="cv_builder_db"

# JSON Web Token (JWT) Configuration
# This is a secret key used to sign JWTs. Keep this secure and private.
# Generate a strong, random string for this value.
JWT_SECRET="your_very_secret_jwt_key_preferably_long_and_random"

# Google OAuth 2.0 Configuration
# =================================
# These credentials are obtained from the Google Cloud Platform (https://console.cloud.google.com/).
# See the project README.md for detailed instructions on how to set up Google OAuth.

# GOOGLE_CLIENT_ID: Your Google OAuth 2.0 Client ID.
# Replace 'YOUR_GOOGLE_CLIENT_ID_PLACEHOLDER' with your actual Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_PLACEHOLDER"

# GOOGLE_CLIENT_SECRET: Your Google OAuth 2.0 Client Secret.
# Replace 'YOUR_GOOGLE_CLIENT_SECRET_PLACEHOLDER' with your actual Client Secret from Google Cloud Console.
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_PLACEHOLDER"

# GOOGLE_CALLBACK_URL: The full URL to your backend's Google OAuth callback endpoint.
# This *MUST* exactly match one of the "Authorized redirect URIs" you configured in Google Cloud Console.
# Example for local development: GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
# Example for production: GOOGLE_CALLBACK_URL="https://yourproductiondomain.com/api/auth/google/callback"
# The backend configuration (src/config.ts) defaults to '/api/auth/google/callback' if this is not set,
# but providing the full URL here is recommended for clarity and explicitness, especially if your
# application is served behind a reverse proxy or has a complex routing setup.
GOOGLE_CALLBACK_URL="/api/auth/google/callback"

# Frontend URL for OAuth Failure Redirects
# =========================================
# This is the URL to your frontend's login page. The backend uses this to redirect users
# with an error message in the query string if Google OAuth authentication fails at the callback stage.
# Example for local development: FRONTEND_LOGIN_URL="http://localhost:3000/login"
# Example for production: FRONTEND_LOGIN_URL="https://yourproductiondomain.com/login"
# The backend configuration (src/routes/auth/authRoutes.ts) defaults to '/login' if this is not set.
# Providing the full URL is recommended for production.
FRONTEND_LOGIN_URL="/login"

# Generative AI API Key (if applicable)
# If you are using a generative AI service (e.g., Google's Gemini API for AI resume suggestions)
# GENAI_API_KEY="YOUR_GENAI_API_KEY"
